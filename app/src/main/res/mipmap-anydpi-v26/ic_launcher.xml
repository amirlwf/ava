<?xml version="1.0" encoding="utf-8"?>
<!-- 0.7.1: Harper's own artwork (anime girl with glowing notes on black),
     pre-cropped to a full-bleed circle. Foreground is the round PNG itself
     and the background is transparent, so the icon is a pure circle on
     every launcher shape — no square corners, no coloured backdrop. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@android:color/transparent" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
