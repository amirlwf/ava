<?xml version="1.0" encoding="utf-8"?>
<!-- 0.1-fix1 (Track I): same purple squircle artwork as ic_launcher.xml.
     The artwork is a full square (not a circle), so on round-icon
     launchers the system masks it to a circle — the neon frame's edges
     may clip slightly there, the centred art (woman + note) is safe.
     The legacy/round PNGs carry the same square artwork. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@android:color/black" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
