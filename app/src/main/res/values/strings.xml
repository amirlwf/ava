    <!-- About -->
    <string name="about_title">About Ava</string>
    <string name="about_version">Version</string>
    <string name="about_offline_title">Fully offline</string>
    <string name="about_offline_body">Ava plays only the music stored on this device. There is no account, no sign-in, no streaming and no ads.</string>
    <string name="about_privacy_title">Privacy</string>
    <string name="about_privacy_body">No music file and no personal information ever leaves your phone. Settings stay on this device.</string>
    <string name="about_built_title">Built with</string>
    <string name="about_built_body">Kotlin, Jetpack Compose, Media3, Room, DataStore and Coil. Persian typeface: Vazirmatn (SIL OFL).</string>
    <string name="about_dedication_title">In memory of Ava</string>
    <string name="about_dedication_body">This app is dedicated to the memory of Ava Rahmani Rad — a 20-year-old actress from Haft Hoz, Tehranpars, who passed away on 9 January 2026. “Ava” is her name, and this app is offered in her memory.</string>
    <string name="about_website_title">Made by Harper</string>
    <string name="about_website_value">amirlwf.ir</string>
    <string name="settings_website">Website</string>
    <string name="settings_website_sub">amirlwf.ir</string>
    <string name="about_diagnostics_title">Crash reports</string>
    <string name="about_diagnostics_body">A crash report was saved on this device. Share the latest one to help fix the problem — nothing is sent automatically.</string>
    <string name="about_diagnostics_none">No crash reports saved. If the app ever closes unexpectedly, the details are saved here.</string>
    <string name="about_diagnostics_share">Share latest crash report</string>

