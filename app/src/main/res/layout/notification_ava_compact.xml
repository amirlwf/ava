<?xml version="1.0" encoding="utf-8"?>
<!-- Ava custom media notification — compact view (0.7.4; restored
     from 0.7.2 — the small icon is now the 0.7.3 PNG, see the provider).
     RemoteViews only: LinearLayout / FrameLayout / ImageView /
     TextView / ProgressBar / ImageButton. No custom fonts here —
     SystemUI renders notification text with the system font, so the
     text colours use the notification theme attributes (primary /
     secondary) and the Ava character comes from the accent circle,
     the artwork and the icons. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <ImageView
        android:id="@+id/notif_art"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_notif_art_placeholder" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/notif_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/notif_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/notif_progress_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/notif_elapsed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="11sp" />

            <ProgressBar
                android:id="@+id/notif_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:indeterminate="false"
                android:max="100"
                android:progress="0" />

            <TextView
                android:id="@+id/notif_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="11sp" />

        </LinearLayout>

    </LinearLayout>

    <ImageButton
        android:id="@+id/notif_prev"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/notif_circle_dark"
        android:padding="9dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_notif_prev" />

    <!-- Accent circle behind play/pause: the white circle drawable is
         tinted with the theme accent at runtime (setColorFilter). -->
    <FrameLayout
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp">

        <ImageView
            android:id="@+id/notif_play_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/notif_circle_white" />

        <ImageButton
            android:id="@+id/notif_play_pause"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:padding="13dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_notif_pause" />

    </FrameLayout>

    <ImageButton
        android:id="@+id/notif_next"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/notif_circle_dark"
        android:padding="9dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_notif_next" />

</LinearLayout>
