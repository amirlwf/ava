<?xml version="1.0" encoding="utf-8"?>
<!-- Ava custom media notification — expanded view (0.7.2).
     Big artwork + title/artist + like button on the top row, progress
     with elapsed/total in the middle, transport centred at the bottom.
     Same RemoteViews limits as the compact view (see its header). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/notif_art"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_notif_art_placeholder" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/notif_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/notif_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="14sp" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/notif_like"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/notif_circle_dark"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_notif_heart" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/notif_progress_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/notif_elapsed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="11sp" />

        <ProgressBar
            android:id="@+id/notif_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:indeterminate="false"
            android:max="100"
            android:progress="0" />

        <TextView
            android:id="@+id/notif_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="11sp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/notif_prev"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/notif_circle_dark"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_notif_prev" />

        <FrameLayout
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp">

            <ImageView
                android:id="@+id/notif_play_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/notif_circle_white" />

            <ImageButton
                android:id="@+id/notif_play_pause"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:padding="15dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_notif_pause" />

        </FrameLayout>

        <ImageButton
            android:id="@+id/notif_next"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/notif_circle_dark"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_notif_next" />

    </LinearLayout>

</LinearLayout>
